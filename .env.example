# ───────────── Merchant service (merchant-api) ─────────────
# PayPal sandbox app credentials (developer.paypal.com → Apps & Credentials → Sandbox).
# Absent → fixture mode: no PayPal calls, deterministic recorded responses.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from the webhook you registered; enables verification
MERCHANT_PUBLIC_URL=http://localhost:8100   # used for PayPal return URLs and the webhook target

# Engine controls (also editable at runtime in the console)
PACT_MODE=review_first          # review_first | autonomous
EV_FLOOR_MINOR=50                  # $0.50
AUTONOMY_CEILING_MINOR=25000       # $250.00
MAX_RECOVERY_ATTEMPTS=2
OFFER_TTL_SECONDS=900
HOLDOUT_RATE=0.10
HOLDOUT_SALT=change-me
CONTRIBUTION_MARGIN=1.0

MERCHANT_DB_PATH=./data/merchant.db

# PRP signing (Ed25519). Generate with: python -m shared.prp.keys generate
MERCHANT_SIGNING_KEY=              # base64url private key — never commit
MERCHANT_KEY_ID=mer_kettle_crumb#k1

# ───────────── Buyer agent service (buyer-agent) ─────────────
BUYER_PUBLIC_URL=http://localhost:8200
BUYER_DB_PATH=./data/buyer.db
BUYER_SIGNING_KEY=                 # base64url Ed25519 private key — never commit
BUYER_KEY_ID=                      # e.g. agt_7f3c#k1, assigned at registration

# ───────────── LLM (both services) ─────────────
# Any OpenAI-compatible chat-completions endpoint. Absent → templates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=              # reasoning models only; else blank

# ───────────── Web (Next.js) ─────────────
NEXT_PUBLIC_MERCHANT_URL=http://localhost:8100
NEXT_PUBLIC_BUYER_URL=http://localhost:8200
JUDGE_MODE=false                   # true on the hosted demo: autonomous mode + reseed on boot
